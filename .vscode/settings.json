{
    "js/ts.experimental.useTsgo": false,
    "prettier.enable": false,
    "css.lint.unknownAtRules": "ignore",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },

    "files.associations": {
        "*.css": "tailwindcss",
        "*.scss": "tailwindcss"
    }
}
