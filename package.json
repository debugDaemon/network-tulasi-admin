    "@nuxt/image": "2.1.0",
    "@nuxt/kit": "^4.6.1",
    "@nuxt/test-utils": "4.3.4",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/robots": "7.0.2",
    "nuxt": "^4.6.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
